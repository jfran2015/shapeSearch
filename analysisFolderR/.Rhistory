ylab("Proportion of first fixation")+
facet_grid(~additionalTargetDistractor)+
scale_fill_brewer(type = "qual", palette = palatte_num)+
theme_classic()+
scale_y_continuous(labels = scales::percent,
breaks = seq(.10,.70, by = .10))
